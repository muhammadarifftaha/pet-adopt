# --- Required ---------------------------------------------------------------
# Long random string (32+ characters) used to sign sessions. Required in production.
# Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=

# Public URL of the site (no trailing slash). Used for share previews and absolute links,
# and it is the only origin allowed to make logged-in requests. Required in production.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- First owner account ----------------------------------------------------
# When no user exists yet, the server creates this owner on startup, so nobody else can
# claim /admin first. Use 12+ characters in production.
# SEED_ADMIN_EMAIL=you@example.com
# SEED_ADMIN_PASSWORD=

# --- Database ---------------------------------------------------------------
# SQLite file for local development (default if DATABASE_URL is unset):
DATABASE_URL=file:./pet-adopt.db
# PostgreSQL for production (Neon, Supabase, your own server...):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/pet_adopt

# --- Optional ---------------------------------------------------------------
# Country code added to local phone numbers that start with 0 (default: 60, Malaysia).
# NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=60

# S3-compatible storage for uploads (AWS S3, Cloudflare R2, MinIO...).
# Leave unset to store uploads on local disk in ./media.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

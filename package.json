{
  "name": "pet-adopt",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source storefront for adoptable pets. Next.js + Drizzle + Better Auth + Puck page builder.",
  "license": "MIT",
  "author": "muhammadarifftaha",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.sqlite.config.ts && drizzle-kit generate --config drizzle.pg.config.ts",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "check:schemas": "tsx scripts/check-schemas.ts",
    "check:backend": "tsx scripts/check-backend.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "admin:reset-password": "tsx --env-file-if-exists=.env scripts/reset-password.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@hookform/resolvers": "^7.0.6",
    "@puckeditor/core": "^0.24.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-bold": "^3.35.0",
    "@tiptap/extension-document": "^3.35.0",
    "@tiptap/extension-italic": "^3.35.0",
    "@tiptap/extension-link": "^3.35.0",
    "@tiptap/extension-list": "^3.35.0",
    "@tiptap/extension-paragraph": "^3.35.0",
    "@tiptap/extension-text": "^3.35.0",
    "@tiptap/extension-underline": "^3.35.0",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "better-auth": "^1.7.21",
    "better-sqlite3": "^13.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "cross-env": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "es-toolkit": "^1.53.2",
    "lucide-react": "^1.72.0",
    "next": "16.4.5",
    "nuqs": "^2.10.3",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.92.0",
    "react-icons": "^5.7.0",
    "shadcn": "^4.23.0",
    "sharp": "0.35.5",
    "swr": "^2.5.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.19.9",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  }
}

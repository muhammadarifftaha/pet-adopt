{
  "name": "pet-adopt",
  "version": "0.1.1",
  "private": true,
  "description": "Open-source storefront for adoptable pets. Next.js + Drizzle + Better Auth + Puck page builder.",
  "license": "MIT",
  "author": "muhammadarifftaha",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "turbo run dev --filter=@pet-adopt/web",
    "build": "turbo run build",
    "start": "pnpm --filter @pet-adopt/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:schemas": "turbo run check:schemas",
    "check:backend": "turbo run check:backend",
    "db:generate": "pnpm --filter @pet-adopt/web db:generate",
    "migrate": "pnpm --filter @pet-adopt/web migrate",
    "seed": "pnpm --filter @pet-adopt/web seed",
    "setup:env": "pnpm --filter @pet-adopt/web setup:env",
    "admin:reset-password": "pnpm --filter @pet-adopt/web admin:reset-password",
    "plugin:generate": "pnpm --filter @pet-adopt/web plugin:generate",
    "dev:docs": "turbo run dev --filter=@pet-adopt/docs"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  }
}

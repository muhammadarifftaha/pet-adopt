# --- Required ---------------------------------------------------------------
# Long random string (32+ characters) used to sign sessions. Required in production.
# Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public URL of the site (no trailing slash). Used for share previews and absolute links,
# and it is the only origin allowed to make logged-in requests. Required in production.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- First owner account ----------------------------------------------------
# When no user exists yet, the server creates this owner on startup, so nobody else can
# claim /admin first. Use 12+ characters in production.
# SEED_ADMIN_EMAIL=you@example.com
# SEED_ADMIN_PASSWORD=

# --- Database ---------------------------------------------------------------
# SQLite file for local development (default if DATABASE_URL is unset). SQLite migrates itself.
DATABASE_URL=file:./pet-adopt.db
# PostgreSQL for production (Neon, Supabase, your own server...). Run `pnpm migrate` first.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/pet_adopt

# --- Optional ---------------------------------------------------------------
# Header your reverse proxy or CDN sets to the real client address, used to limit sign-in guessing
# (default x-forwarded-for; Cloudflare uses cf-connecting-ip). Only trust a header your proxy
# overwrites: without one in front, a client can send any value.
# CLIENT_IP_HEADER=x-forwarded-for
# How many proxies append to that header between the internet and the app (default 1). With a CDN
# in front of your own proxy that is 2: the client address is then the second entry from the end.
# TRUSTED_PROXY_HOPS=1

# PostgreSQL only: cancel any query that runs longer than this many milliseconds (default 15000,
# 0 turns it off). `pnpm migrate` turns it off by itself.
# DB_STATEMENT_TIMEOUT_MS=15000

# Country code added to local phone numbers that start with 0 (default: 60, Malaysia).
# NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=60

# Send the Content-Security-Policy as report-only (violations are logged in the browser console,
# nothing is blocked). Handy while you try new embeds or scripts. Remove it to enforce the policy.
# CSP_REPORT_ONLY=1

# S3-compatible storage for uploads (AWS S3, Cloudflare R2, MinIO...).
# Leave unset to store uploads on local disk (./media, or the folder in UPLOAD_DIR).
# UPLOAD_DIR=./media
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Email (password reset links), sent by an email plugin in pet-adopt.config.ts. The Resend plugin
# switches itself on when RESEND_API_KEY is set. Without any email plugin, reset links are made by
# an admin (Users screen) and shared by hand.
# RESEND_API_KEY=
# EMAIL_FROM=Pet Adopt <no-reply@adopt.example.com>

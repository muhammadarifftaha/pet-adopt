# --- Required ---------------------------------------------------------------
# Long random string (32+ characters) used to sign sessions. Required in production.
# Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public URL of the site (no trailing slash). Used for share previews and absolute links,
# and it is the only origin allowed to make logged-in requests. Required in production.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- First owner account ----------------------------------------------------
# When no user exists yet, the server creates this owner on startup, so nobody else can
# claim /admin first. Use 12+ characters in production.
# SEED_ADMIN_EMAIL=you@example.com
# SEED_ADMIN_PASSWORD=

# --- Database ---------------------------------------------------------------
# SQLite file (default if DATABASE_URL is unset). Needs no server and migrates itself on start.
DATABASE_URL=file:../../data/pet-adopt.db
# PostgreSQL (Neon, Supabase, your own server...). `pnpm build` migrates it (or run `pnpm migrate`).
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/pet_adopt
# Optional: SQLite hosted by Turso (a paid/free-tier service) or your own libSQL server
# (sqld). `pnpm build` migrates it (or run `pnpm migrate`). The token comes from `turso db tokens create <db>`.
# DATABASE_URL=libsql://<db>-<org>.turso.io
# DATABASE_AUTH_TOKEN=

# --- Optional ---------------------------------------------------------------
# Header your reverse proxy or CDN sets to the real client address, used to limit sign-in guessing
# (default x-forwarded-for; Cloudflare uses cf-connecting-ip). Only trust a header your proxy
# overwrites: without one in front, a client can send any value.
# CLIENT_IP_HEADER=x-forwarded-for
# How many proxies append to that header between the internet and the app (default 1). With a CDN
# in front of your own proxy that is 2: the client address is then the second entry from the end.
# TRUSTED_PROXY_HOPS=1

# PostgreSQL only: cancel any query that runs longer than this many milliseconds (default 15000,
# 0 turns it off). `pnpm migrate` turns it off by itself.
# DB_STATEMENT_TIMEOUT_MS=15000

# Country code added to local phone numbers that start with 0 (default: 60, Malaysia).
# NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=60

# How many days the activity log keeps its entries (default 365). Older ones are removed
# automatically.
# ACTIVITY_LOG_DAYS=365

# Send the Content-Security-Policy as report-only (violations are logged in the browser console,
# nothing is blocked). Handy while you try new embeds or scripts. Remove it to enforce the policy.
# CSP_REPORT_ONLY=1

# --- Migrations on build --------------------------------------------------------
# `pnpm build` migrates PostgreSQL and hosted libSQL before building (a local SQLite file migrates
# itself on start). Vercel preview builds skip it unless MIGRATE_ON_PREVIEW=1 (only when previews
# have their own database). SKIP_BUILD_MIGRATE=1 skips it for builds that cannot reach the
# database; run `pnpm migrate` before starting the server then.
# MIGRATE_ON_PREVIEW=
# SKIP_BUILD_MIGRATE=

# --- Upload storage (required) ----------------------------------------------------
# Uploads live only in S3-compatible object storage, never on the server's disk. Production
# refuses to start without S3_BUCKET and the keys. The bucket can stay private, because visitors
# load images through this site's /media route. Check it with
# `pnpm --filter @pet-adopt/web storage:check`.
#
# These values are the development server: `docker compose up -d garage`.
S3_BUCKET=pet-adopt-media
# The provider's S3 API address (scheme and host only). Leave unset for AWS S3.
S3_ENDPOINT=http://localhost:9000
# Give production keys read, write and delete access to this bucket only.
S3_ACCESS_KEY_ID=GK0123456789abcdef01234567
S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Default us-east-1. Use your bucket's region on AWS; other providers document theirs or ignore it.
# S3_REGION=
# Path-style addresses (endpoint/bucket/key) are the default with S3_ENDPOINT, as every
# S3-compatible server supports them. Set false if your provider wants bucket.endpoint/key.
# S3_FORCE_PATH_STYLE=
# Optional folder inside the bucket, so several sites or environments can share one (site/uploads).
# S3_PREFIX=
#
# Moving a site that kept uploads on disk (data/media): `pnpm --filter @pet-adopt/web storage:copy-local`.

# --- Email (optional) ---------------------------------------------------------------
# The site sends email (password reset links, form notifications) over SMTP. Set it up in the admin
# under Email > Sending; any variable set here overrides that field and shows it read-only there.
# Without email, reset links are made by an admin (Users screen) and shared by hand.
# For development, `docker compose up -d mailpit` catches every email at http://localhost:8025:
# server localhost, port 1025, encryption none.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# starttls (usually port 587), tls (usually 465) or none (local test servers only)
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=Pet Adopt <no-reply@adopt.example.com>
# EMAIL_REPLY_TO=
